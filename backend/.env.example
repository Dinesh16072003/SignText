# Copy this file to backend/.env, then adjust the values.
# backend/.env is ignored by git. Never commit real secrets.

# Database location. The default is a local SQLite file named signtext.sqlite
# created next to this backend folder.
SIGNTEXT_DATABASE_URL=sqlite:///./signtext.sqlite

# Secret used to sign login tokens. Generate a long random value before using
# real accounts, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it out of git.
SIGNTEXT_SECRET_KEY=

# Comma-separated list of browser origins allowed to call this API.
SIGNTEXT_CORS_ORIGINS=http://localhost:5173

# How long an access token stays valid, and how long a refresh token lasts.
SIGNTEXT_ACCESS_TOKEN_MINUTES=30
SIGNTEXT_REFRESH_TOKEN_DAYS=30

# Login throttling: after this many failed attempts from one address within
# the window, further attempts are refused until the window passes.
SIGNTEXT_LOGIN_RATE_LIMIT=10
SIGNTEXT_LOGIN_RATE_WINDOW_SECONDS=60
