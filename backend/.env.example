# Copy this file to backend/.env, then adjust the values.
# backend/.env is ignored by git. Never commit real secrets.

# Database location. The default is a local SQLite file named signtext.sqlite
# created next to this backend folder.
SIGNTEXT_DATABASE_URL=sqlite:///./signtext.sqlite

# Secret used to sign login tokens. Generate a long random value before using
# real accounts, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it out of git.
SIGNTEXT_SECRET_KEY=

# Comma-separated list of browser origins allowed to call this API.
SIGNTEXT_CORS_ORIGINS=http://localhost:5173

# How long an access token stays valid, and how long a refresh token lasts.
SIGNTEXT_ACCESS_TOKEN_MINUTES=30
SIGNTEXT_REFRESH_TOKEN_DAYS=30

# Password limits. The minimum is enforced in code; the maximum protects the
# server from hashing huge inputs. Together with SIGNTEXT_MAX_BODY_BYTES below
# this keeps signup and login requests cheap to process.
SIGNTEXT_PASSWORD_MAX_LENGTH=128

# Largest accepted request body in bytes. Rejections return HTTP 413. Keep this
# a bit above the largest legitimate payload (a 5000-character translation is
# about 6 KB); raise it if future endpoints accept real uploads.
SIGNTEXT_MAX_BODY_BYTES=500000

# Login throttling: after this many failed attempts from one address within
# the window, further attempts are refused until the window passes.
SIGNTEXT_LOGIN_RATE_LIMIT=10
SIGNTEXT_LOGIN_RATE_WINDOW_SECONDS=60

# Applies versioned migrations in migrations/versions/ to the database on
# server startup. The test suite sets this to 0 so tests never touch the real
# database file. To run migrations by hand instead, use this from the backend
# folder:  .venv/Scripts/python.exe -m migrations.migrate
SIGNTEXT_RUN_MIGRATIONS=1
