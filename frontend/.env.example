# Copy this file to .env and fill in the values.
#
# The FastAPI backend that the app talks to. The Vite dev server runs on
# http://localhost:5173 and the backend on http://localhost:8000 by default.
VITE_API_URL=http://localhost:8000

# Supabase is still wired up for logging in. Use the anon public key only,
# never the service role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
